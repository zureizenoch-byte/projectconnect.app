# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # server only, never expose to the browser

# Public site URL (used for Stripe redirects and email links)
NEXT_PUBLIC_SITE_URL=https://projectconnect.app

# Stripe — leave blank to run with billing stubbed out
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SIX_MONTH=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_TWELVE_MONTH=

# Google Maps — optional. Without it, venue search falls back to OpenStreetMap
# and maps render through the keyless embed. Enable "Places API (New)" and
# "Maps Embed API", then restrict the key to your domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email — send from your own GoDaddy mailbox over SMTP.
# Microsoft 365 (most GoDaddy plans): smtp.office365.com, port 587
# GoDaddy classic/cPanel email:       smtpout.secureserver.net, port 465
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=hello@projectconnect.app
SMTP_PASS=
EMAIL_FROM=Project Connect <hello@projectconnect.app>
EMAIL_REPLY_TO=hello@projectconnect.app

# Optional fallback if you ever move off your own mailbox
RESEND_API_KEY=
